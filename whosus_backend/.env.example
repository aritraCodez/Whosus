# Exact browser origins, without trailing slashes. Local Python can read this with --env-file .env.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Browser fallback discovery servers; set STUN_URL= for isolated local-only ICE.
STUN_URL=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# Configure on a reachable coturn server. Never put TURN_SECRET in frontend code.
TURN_URL=
TURN_SECRET=
TURN_REALM=voice.example.com
TURN_EXTERNAL_IP=
