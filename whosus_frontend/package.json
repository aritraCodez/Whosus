{
  "name": "whosus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "format:check": "prettier --check src test scripts *.js *.json vite.config.ts index.html README.md",
    "format": "prettier --write src test scripts *.js *.json vite.config.ts index.html README.md",
    "test:models": "node test/model-test.mjs",
    "test:session": "node test/session-test.mjs",
    "test:wardrobe": "node test/wardrobe-test.mjs",
    "test:mosslight": "node test/mosslight-test.mjs",
    "test:pokemon": "node test/pokemon-test.mjs",
    "test:seating": "node test/seating-test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node test/browser-test.mjs",
    "test:scene": "node test/scene-test.mjs",
    "test:movement": "node test/movement-test.mjs",
    "test:room": "node test/room-test.mjs",
    "test:bots": "node test/bot-test.mjs",
    "test:voice": "node test/voice-test.mjs",
    "test:voice-errors": "node test/voice-error-test.mjs",
    "test:mobile-chat": "node test/mobile-chat-test.mjs",
    "test:mobile-menu": "node test/mobile-menu-test.mjs",
    "test:dialogs": "node test/dialog-layout-test.mjs",
    "test:create-room": "node test/create-room-test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.3.0"
  }
}
